# Адрес бэкенда (lifts-back), без слэша в конце
NEXT_PUBLIC_API_URL=http://localhost:4000

# Публичный адрес сайта: metadataBase, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Общий секрет с бэкендом (REVALIDATE_SECRET): бэкенд вызывает /api/revalidate после правок в админке
REVALIDATE_SECRET=dev-revalidate-secret
